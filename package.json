{
  "name": "inclu.si",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "news:ingest": "node --env-file-if-exists=.env ./scripts/fetch-news.mjs",
    "tweets:ingest": "node --env-file-if-exists=.env ./scripts/fetch-a11y-tweets.mjs",
    "facebook:ingest": "node --env-file-if-exists=.env ./scripts/fetch-facebook-signals.mjs",
    "news:digest": "node --env-file-if-exists=.env ./scripts/generate-daily-digest.mjs",
    "news:cluster": "node --env-file-if-exists=.env ./scripts/dedupe-and-cluster.mjs",
    "news:pipeline": "npm run news:ingest && npm run news:cluster",
    "tweets:pipeline": "npm run tweets:ingest && npm run news:cluster",
    "news:backfill-zh": "node --env-file-if-exists=.env ./scripts/backfill-zh-translations.mjs"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.2.4",
    "apify-client": "^2.12.3",
    "astro": "^6.1.9",
    "google-news-url-decoder": "^1.2.1",
    "rss-parser": "^3.13.0",
    "tailwindcss": "^4.2.4"
  }
}
