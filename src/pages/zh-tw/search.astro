---
import Layout from '../../layouts/Layout.astro';
---

<Layout locale="zh-TW" title="搜尋 | Inclu.si">
  <main class="mx-auto w-full max-w-4xl px-5 py-10 sm:px-8 sm:py-14">
    <section class="rounded-3xl border border-slate-200 bg-white p-6 sm:p-8">
      <h1 class="font-['Merriweather'] text-4xl font-black tracking-tight text-slate-900">搜尋</h1>
      <p class="mt-3 text-slate-600">可依關鍵字搜尋已發佈新聞與來源名稱。</p>
      <div id="search" class="mt-6"></div>
    </section>
  </main>

  <link href="/pagefind/pagefind-ui.css" rel="stylesheet" />
  <script is:inline src="/pagefind/pagefind-ui.js"></script>
  <script is:inline>
    if (window.PagefindUI) {
      new window.PagefindUI({
        element: '#search',
        showSubResults: true,
        showImages: false,
        translations: {
          placeholder: '搜尋無障礙新聞...',
          clear_search: '清除',
          load_more: '載入更多',
          zero_results: '找不到「[SEARCH_TERM]」的結果',
        },
      });
    }
  </script>
</Layout>
