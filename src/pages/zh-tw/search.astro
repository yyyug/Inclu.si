---
import Layout from '../../layouts/Layout.astro';
---

<Layout locale="zh-TW" title="搜尋 | Inclu.si">
  <main class="mx-auto w-full max-w-4xl px-5 py-10 sm:px-8 sm:py-14">
    <section class="rounded-3xl border border-slate-200 bg-white p-6 sm:p-8">
      <h1 class="font-['Merriweather'] text-4xl font-black tracking-tight text-slate-900">搜尋</h1>
      <p class="mt-3 text-slate-600">在所有已發布的內容中搜尋報導、主題與來源名稱。</p>
      <label for="search-input" class="sr-only">搜尋</label>
      <input
        id="search-input"
        type="search"
        placeholder="搜尋無障礙新聞..."
        autocomplete="off"
        class="mt-6 w-full rounded-2xl border border-slate-300 bg-white px-5 py-3 text-base text-slate-900 shadow-sm transition-all duration-300 focus:border-indigo-500 focus:outline-none focus:ring-4 focus:ring-indigo-100"
      />
      <p id="search-status" class="mt-4 text-sm font-semibold text-slate-500" aria-live="polite"></p>
      <div id="search-results" class="mt-4 space-y-6"></div>
    </section>
  </main>

  <script is:inline>
    const input = document.getElementById('search-input');
    const status = document.getElementById('search-status');
    const results = document.getElementById('search-results');
    let index = [];
    let timer = null;

    const esc = (s) => String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');

    const fmt = (iso) => {
      try {
        return new Date(iso).toLocaleDateString('zh-Hant-TW', { year: 'numeric', month: 'short', day: 'numeric' });
      } catch {
        return '';
      }
    };

    const categoryLabels = {
      'digital-a11y': '數位無障礙',
      'assistive-tech': '輔助科技',
      'laws-rights': '政策與法規',
      'physical-design': '空間與通用設計',
      'lifestyle-culture': '文化與生活',
      'case-studies': '案例與最佳實踐',
      'social-signals': '社群訊號',
      general: '綜合',
    };

    fetch('/zh-tw/search-index.json')
      .then((r) => r.json())
      .then((data) => {
        index = data;
        status.textContent = `已索引 ${index.length} 則報導`;
      })
      .catch(() => {
        status.textContent = '搜尋索引載入失敗。';
      });

    const render = (items) => {
      if (!items.length) {
        results.innerHTML =
          '<p class="rounded-3xl border border-dashed border-slate-300 bg-white p-8 text-slate-600">找不到相關報導。</p>';
        return;
      }
      results.innerHTML = items
        .map(
          (item) => `
            <article class="rounded-3xl border border-slate-200 bg-white p-5 shadow-sm sm:p-6">
              <div class="flex flex-wrap items-center gap-3 text-sm text-slate-600">
                <span class="rounded-full bg-indigo-600 px-3 py-1 font-semibold text-white">${esc(categoryLabels[item.category] ?? item.category)}</span>
                <time datetime="${esc(item.publishedAt)}">${esc(fmt(item.publishedAt))}</time>
              </div>
              <h2 class="mt-4 text-xl font-black tracking-tight text-slate-900 sm:text-2xl">
                <a href="${esc(item.url)}" class="focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-indigo-300">${esc(item.title)}</a>
              </h2>
              <p class="mt-3 text-base leading-relaxed text-slate-700">${esc(item.summary)}</p>
            </article>
          `
        )
        .join('');
    };

    input.addEventListener('input', () => {
      clearTimeout(timer);
      timer = setTimeout(() => {
        const q = input.value.trim().toLowerCase();
        if (!q) {
          status.textContent = index.length ? `已索引 ${index.length} 則報導` : '';
          results.innerHTML = '';
          return;
        }
        const terms = q.split(/\s+/).filter(Boolean);
        const scored = [];
        for (const item of index) {
          let score = 0;
          const title = item.title.toLowerCase();
          const summary = item.summary.toLowerCase();
          const source = (item.sourceName || '').toLowerCase();
          const tags = (item.tags || []).join(' ').toLowerCase();
          const cat = (categoryLabels[item.category] || item.category || '').toLowerCase();
          for (const term of terms) {
            if (title.includes(term)) score += 3;
            if (summary.includes(term)) score += 2;
            if (source.includes(term)) score += 1;
            if (tags.includes(term)) score += 1;
            if (cat.includes(term)) score += 1;
          }
          if (score > 0) scored.push({ item, score });
        }
        scored.sort((a, b) => b.score - a.score || new Date(b.item.publishedAt) - new Date(a.item.publishedAt));
        const top = scored.slice(0, 50).map((s) => s.item);
        status.textContent = `${scored.length} 則結果`;
        render(top);
      }, 200);
    });
  </script>
</Layout>
