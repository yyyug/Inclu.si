---
import NewsArticle from '../../../components/news/NewsArticle.astro';
import { getPublishedNewsByLocale, getPublishedNewsBySlug } from '../../../lib/news';

export async function getStaticPaths() {
  const entries = await getPublishedNewsByLocale('en');
  return entries.map((entry) => ({
    params: { slug: entry.data.slug },
    props: { slug: entry.data.slug },
  }));
}

const { slug } = Astro.props;
const entry = await getPublishedNewsBySlug('en', slug);

if (!entry) {
  throw new Error(`News entry not found for slug: ${slug}`);
}
---

<NewsArticle locale="en" entry={entry} />
