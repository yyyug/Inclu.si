---
import Layout from '../layouts/Layout.astro';
---

<Layout locale="en" title="Not Found | Inclu.si">
  <main class="mx-auto flex min-h-screen w-full max-w-3xl items-center px-6 py-12">
    <section class="w-full rounded-3xl border border-slate-200 bg-white p-8 text-center">
      <h1 class="font-['Merriweather'] text-4xl font-black tracking-tight text-slate-900">404</h1>
      <p class="mt-4 text-base leading-relaxed text-slate-600">The page was not found.</p>
      <div class="mt-6 flex justify-center gap-3">
        <a href="/en/" class="rounded-full bg-indigo-600 px-5 py-2 font-bold text-white transition-all duration-300 hover:-translate-y-0.5 hover:shadow-lg">English</a>
        <a href="/zh-tw/" class="rounded-full border border-slate-300 bg-white px-5 py-2 font-bold text-slate-700 transition-all duration-300 hover:border-indigo-400 hover:text-indigo-700">繁體中文</a>
      </div>
    </section>
  </main>
</Layout>
