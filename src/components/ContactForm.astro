---
import Layout from '../layouts/Layout.astro';
import type { Locale } from '../lib/i18n';
import { localeBasePath } from '../lib/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const isZh = locale === 'zh-TW';
const title = isZh ? '聯絡我們' : 'Contact Us';
const description = isZh
  ? '若你有無障礙新聞來源建議，歡迎透過表單聯絡 Inclu.si 團隊。'
  : 'Share accessibility news source suggestions with the Inclu.si team.';
const backHref = localeBasePath(locale);
---

<Layout locale={locale} title={`${title} | Inclu.si`} description={description}>
  <main class="mx-auto w-full max-w-3xl px-5 py-10 sm:px-8 sm:py-14">
    <section class="rounded-3xl border border-slate-200 bg-white p-6 sm:p-9">
      <a href={backHref} class="text-sm font-semibold text-indigo-700 hover:text-indigo-800">
        {isZh ? '← 回到首頁' : '← Back to Home'}
      </a>

      <h1 class="mt-4 font-['Merriweather'] text-4xl font-black tracking-tight text-slate-900">{title}</h1>
      <p class="mt-3 text-base leading-relaxed text-slate-600">
        {isZh
          ? '有推薦的新聞網站、社群帳號或議題線索，歡迎填寫以下表單。'
          : 'Have a source recommendation, account, or topic tip? Send it here.'}
      </p>

      <form id="contact-form" class="mt-8 grid gap-4" data-locale={locale}>
        <label class="grid gap-2">
          <span class="text-sm font-semibold text-slate-700">{isZh ? '姓名' : 'Name'}</span>
          <input
            required
            name="name"
            type="text"
            class="rounded-xl border border-slate-300 px-4 py-3 text-slate-800 outline-none transition-all focus:border-indigo-400 focus:ring-2 focus:ring-indigo-100"
            placeholder={isZh ? '你的名字' : 'Your name'}
          />
        </label>

        <label class="grid gap-2">
          <span class="text-sm font-semibold text-slate-700">{isZh ? 'Email' : 'Email'}</span>
          <input
            required
            name="email"
            type="email"
            class="rounded-xl border border-slate-300 px-4 py-3 text-slate-800 outline-none transition-all focus:border-indigo-400 focus:ring-2 focus:ring-indigo-100"
            placeholder={isZh ? 'you@example.com' : 'you@example.com'}
          />
        </label>

        <label class="grid gap-2">
          <span class="text-sm font-semibold text-slate-700">{isZh ? '來源建議或留言' : 'Source Suggestion or Message'}</span>
          <textarea
            required
            name="message"
            rows="6"
            class="rounded-xl border border-slate-300 px-4 py-3 text-slate-800 outline-none transition-all focus:border-indigo-400 focus:ring-2 focus:ring-indigo-100"
            placeholder={isZh ? '例如：推薦追蹤某個 RSS、Facebook 或 X 帳號' : 'For example: suggest an RSS source, Facebook page, or X account'}
          ></textarea>
        </label>

        <label class="hidden" aria-hidden="true">
          <span>Company</span>
          <input name="company" type="text" tabindex="-1" autocomplete="off" />
        </label>

        <div class="cf-turnstile" data-sitekey="0x4AAAAAADGJaHY77kTpgVMd" data-theme="light"></div>

        <div class="mt-2 flex items-center gap-3">
          <button
            id="contact-submit"
            type="submit"
            class="rounded-full bg-indigo-600 px-5 py-2.5 text-sm font-bold text-white transition-all hover:bg-indigo-700 disabled:cursor-not-allowed disabled:opacity-70"
          >
            {isZh ? '送出' : 'Send'}
          </button>
          <p id="contact-status" class="text-sm text-slate-600"></p>
        </div>
      </form>
    </section>
  </main>

  <script is:inline>
    const form = document.getElementById('contact-form');
    const submitButton = document.getElementById('contact-submit');
    const statusEl = document.getElementById('contact-status');

    if (form && submitButton && statusEl) {
      form.addEventListener('submit', async (event) => {
        event.preventDefault();

        const locale = form.getAttribute('data-locale') || 'en';
        const formData = new FormData(form);
        const name = String(formData.get('name') || '').trim();
        const email = String(formData.get('email') || '').trim();
        const message = String(formData.get('message') || '').trim();
        const company = String(formData.get('company') || '').trim();
        const turnstileToken = String(formData.get('cf-turnstile-response') || '').trim();

        if (company) {
          statusEl.textContent = '';
          return;
        }

        if (!turnstileToken) {
          statusEl.textContent = locale === 'zh-TW' ? '請完成驗證後再送出。' : 'Please complete the CAPTCHA before submitting.';
          return;
        }

        submitButton.setAttribute('disabled', 'disabled');
        statusEl.textContent = locale === 'zh-TW' ? '傳送中...' : 'Sending...';

        try {
          const response = await fetch('/api/contact', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
            },
            body: JSON.stringify({
              locale,
              name,
              email,
              message,
              company,
              turnstileToken,
            }),
          });

          if (!response.ok) {
            const text = await response.text();
            throw new Error(text || `HTTP ${response.status}`);
          }

          form.reset();
          statusEl.textContent = locale === 'zh-TW'
            ? '已送出，謝謝你的建議。'
            : 'Sent. Thanks for your suggestion.';
        } catch (error) {
          statusEl.textContent = locale === 'zh-TW'
            ? `送出失敗：${error?.message || '未知錯誤'}`
            : `Failed to send: ${error?.message || 'Unknown error'}`;
        } finally {
          submitButton.removeAttribute('disabled');
        }
      });
    }
  </script>
  <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
</Layout>
