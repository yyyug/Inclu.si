---
import Layout from '../../layouts/Layout.astro';
import type { Locale } from '../../lib/i18n';
import { localeBasePath, siteCopy } from '../../lib/i18n';
import { collectCategoryCounts, getPublishedNewsByLocale } from '../../lib/news';
import { buildHighlightLinks, getLatestDailyDigest, getLatestWeeklyDigest, loadAllDailyDigests } from '../../lib/digests';
import SiteHeader from './SiteHeader.astro';
import NewsPaginated from './NewsPaginated.astro';
import DigestCard from './DigestCard.astro';

interface Props {
  locale: Locale;
  currentPage?: number;
  activeCategory?: string;
}

const { locale, currentPage = 1, activeCategory = '' } = Astro.props;
const copy = siteCopy[locale];
const entries = await getPublishedNewsByLocale(locale);
const categoryCounts = collectCategoryCounts(entries);
const latestDigest = await getLatestDailyDigest();
const localeDigest = latestDigest ? latestDigest[locale] ?? null : null;
const entryBySlug = new Map(entries.map((entry) => [entry.data.slug, entry]));
const highlightLinks = buildHighlightLinks(localeDigest, entryBySlug, localeBasePath(locale));

const allDaily = await loadAllDailyDigests();
const digestIndex = latestDigest ? allDaily.findIndex((d) => d.date === latestDigest.date) : -1;
const prevDate = digestIndex > 0 ? allDaily[digestIndex - 1].date : null;
const latestWeekly = await getLatestWeeklyDigest();

const perPage = 20;
const filteredEntries = activeCategory
  ? entries.filter((entry) => entry.data.category === activeCategory)
  : entries;
const totalPages = Math.max(1, Math.ceil(filteredEntries.length / perPage));
const page = Math.min(Math.max(1, currentPage), totalPages);
const pageEntries = filteredEntries.slice((page - 1) * perPage, page * perPage);
---

<Layout locale={locale} title={copy.siteTitle}>
  <div class="mx-auto w-full max-w-6xl px-5 pt-10 sm:px-8 sm:pt-14">
    <SiteHeader locale={locale} />
  </div>

  <main class="mx-auto flex w-full max-w-6xl flex-col space-y-12 px-5 pb-10 pt-6 sm:px-8 sm:pb-14 sm:pt-8">

    <section class="rounded-2xl border border-slate-200 bg-white px-6 py-5 sm:px-8">
      <p class="text-base leading-relaxed text-slate-600">{copy.intro}</p>
      <p class="mt-3 text-base leading-relaxed text-slate-600">
        {copy.contactInvite}
        <a
          href={`${localeBasePath(locale)}/contact`}
          class="font-bold text-indigo-700 underline decoration-indigo-300 underline-offset-2 hover:text-indigo-800"
        >
          {copy.contactLinkLabel}
        </a>
        {locale === 'zh-TW' ? '。' : '.'}
      </p>
    </section>

    <DigestCard
      locale={locale}
      heading={copy.digest}
      updatedBadge={
        latestDigest
          ? `${copy.digestUpdated}: ${new Date(latestDigest.generatedAt).toLocaleDateString(locale === 'zh-TW' ? 'zh-Hant-TW' : 'en-US')}`
          : undefined
      }
      digest={localeDigest}
      fallbackText={copy.digestFallback}
      highlightLinks={highlightLinks}
      currentLabel={latestDigest ? latestDigest.date : undefined}
      prevHref={prevDate ? `${localeBasePath(locale)}/digests/${prevDate}` : null}
      nextHref={null}
      prevLabel={copy.digestPreviousDay}
      nextLabel={copy.digestNextDay}
      weekHref={latestWeekly ? `${localeBasePath(locale)}/digests/week/${latestWeekly.week}` : null}
      weekLabel={copy.digestViewWeekly}
    />

    <section class="rounded-3xl border border-slate-200 bg-white p-5 sm:p-8">
      <div>
        <h2 class="font-['Merriweather'] text-3xl font-black tracking-tight text-slate-900">{copy.latest}</h2>
      </div>
    </section>

    <NewsPaginated
      locale={locale}
      entries={pageEntries}
      categoryCounts={categoryCounts}
      currentPage={page}
      totalPages={totalPages}
      perPage={perPage}
      activeCategory={activeCategory}
    />
  </main>
</Layout>
