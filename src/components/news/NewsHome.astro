---
import Layout from '../../layouts/Layout.astro';
import type { Locale } from '../../lib/i18n';
import { localeBasePath, siteCopy } from '../../lib/i18n';
import { collectCategoryCounts, getPublishedNewsByLocale } from '../../lib/news';
import SiteHeader from './SiteHeader.astro';
import NewsPaginated from './NewsPaginated.astro';
import digestData from '../../data/daily-digest.json';

interface Props {
  locale: Locale;
  currentPage?: number;
  activeCategory?: string;
}

const { locale, currentPage = 1, activeCategory = '' } = Astro.props;
const copy = siteCopy[locale];
const entries = await getPublishedNewsByLocale(locale);
const categoryCounts = collectCategoryCounts(entries);
const localeDigest = digestData[locale] ?? null;
const entryBySlug = new Map(entries.map((entry) => [entry.data.slug, entry]));

const perPage = 20;
const filteredEntries = activeCategory
  ? entries.filter((entry) => entry.data.category === activeCategory)
  : entries;
const totalPages = Math.max(1, Math.ceil(filteredEntries.length / perPage));
const page = Math.min(Math.max(1, currentPage), totalPages);
const pageEntries = filteredEntries.slice((page - 1) * perPage, page * perPage);
---

<Layout locale={locale} title={copy.siteTitle}>
  <div class="mx-auto w-full max-w-6xl px-5 pt-10 sm:px-8 sm:pt-14">
    <SiteHeader locale={locale} />
  </div>

  <main class="mx-auto flex w-full max-w-6xl flex-col space-y-12 px-5 pb-10 pt-6 sm:px-8 sm:pb-14 sm:pt-8">

    <section class="rounded-2xl border border-slate-200 bg-white px-6 py-5 sm:px-8">
      <p class="text-base leading-relaxed text-slate-600">{copy.intro}</p>
      <p class="mt-3 text-base leading-relaxed text-slate-600">
        {copy.contactInvite}
        <a
          href={`${localeBasePath(locale)}/contact`}
          class="font-bold text-indigo-700 underline decoration-indigo-300 underline-offset-2 hover:text-indigo-800"
        >
          {copy.contactLinkLabel}
        </a>
        {locale === 'zh-TW' ? '。' : '.'}
      </p>
    </section>

    <section class="rounded-3xl border border-indigo-200 bg-gradient-to-r from-indigo-50 via-white to-cyan-50 p-5 sm:p-8">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <h2 class="font-['Merriweather'] text-3xl font-black tracking-tight text-slate-900">{copy.digest}</h2>
        <span class="rounded-full border border-indigo-200 bg-white px-3 py-1 text-xs font-bold uppercase tracking-wide text-indigo-700">
          {copy.digestUpdated}: {new Date(digestData.generatedAt).toLocaleDateString(locale === 'zh-TW' ? 'zh-Hant-TW' : 'en-US')}
        </span>
      </div>
      {localeDigest?.highlights && localeDigest.highlights.length > 0 ? (
        <>
          <p class="mt-4 font-['Merriweather'] text-lg leading-relaxed text-slate-700">{localeDigest.summary}</p>
          <ul class="mt-5 grid gap-3 sm:grid-cols-2">
            {localeDigest.highlights.map((item) => {
              const entry = entryBySlug.get(item.slug);
              const sourceHref = entry?.data.sourceUrl ?? localeBasePath(locale);
              const isExternal = sourceHref.startsWith('http://') || sourceHref.startsWith('https://');

              return (
                <li class="rounded-2xl border border-white/80 bg-white/70 p-4">
                  <a
                    href={sourceHref}
                    target={isExternal ? '_blank' : undefined}
                    rel={isExternal ? 'noopener noreferrer' : undefined}
                    class="font-semibold text-slate-800 transition-all duration-300 hover:text-indigo-700"
                  >
                    {entry?.data.title ?? item.title}
                  </a>
                </li>
              );
            })}
          </ul>
        </>
      ) : (
        <p class="mt-4 text-slate-600">{copy.digestFallback}</p>
      )}
    </section>

    <section class="rounded-3xl border border-slate-200 bg-white p-5 sm:p-8">
      <div>
        <h2 class="font-['Merriweather'] text-3xl font-black tracking-tight text-slate-900">{copy.latest}</h2>
      </div>
    </section>

    <NewsPaginated
      locale={locale}
      entries={pageEntries}
      categoryCounts={categoryCounts}
      currentPage={page}
      totalPages={totalPages}
      perPage={perPage}
      activeCategory={activeCategory}
    />
  </main>
</Layout>
