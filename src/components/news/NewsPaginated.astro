---
import type { Locale } from '../../lib/i18n';
import type { NewsEntry } from '../../lib/news';
import { categoryLabels } from '../../lib/categories';
import { localeBasePath, siteCopy } from '../../lib/i18n';
import StoryCard from './StoryCard.astro';

interface Props {
  locale: Locale;
  entries: NewsEntry[];
  categoryCounts: Array<{ key: string; count: number }>;
  currentPage?: number;
  perPage?: number;
}

const { locale, entries, categoryCounts, currentPage = 1, perPage = 20 } = Astro.props;
const copy = siteCopy[locale];
const basePath = localeBasePath(locale);
---

<section class="space-y-8" data-base-path={basePath} data-per-page={String(perPage)} data-initial-page={String(currentPage)}>
  {/* Category Filter */}
  <div id="category-filter" class="flex flex-wrap gap-2">
    <a
      href={basePath}
      data-category=""
      class="category-btn rounded-full border-2 border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-700 transition-all duration-300 hover:border-indigo-400 hover:text-indigo-700"
    >
      {copy.allCategories}
    </a>
    {categoryCounts.map((item) => (
      <a
        href={`${basePath}?category=${item.key}`}
        data-category={item.key}
        class="category-btn rounded-full border-2 border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-700 transition-all duration-300 hover:border-indigo-400 hover:text-indigo-700"
      >
        {categoryLabels[item.key]?.[locale]} ({item.count})
      </a>
    ))}
  </div>

  {/* Stories */}
  <div id="stories-container">
    {entries.map((entry, index) => (
      <article data-story data-category={entry.data.category} data-index={String(index)} style="display:none">
        <StoryCard locale={locale} entry={entry} />
      </article>
    ))}
    <article id="stories-empty" style="display:none" class="rounded-3xl border border-dashed border-slate-300 bg-white p-8 text-slate-600">
      {copy.empty}
    </article>
  </div>

  {/* Pagination */}
  <nav id="pagination-nav" aria-label="Pagination" class="hidden items-center justify-center gap-4 py-8">
    <button
      id="prev-btn"
      type="button"
      class="rounded-full border border-slate-300 bg-white px-6 py-2 font-semibold text-slate-700 transition-all duration-300 hover:border-indigo-400 hover:text-indigo-700"
    >
      ← {locale === 'zh-TW' ? '上一頁' : 'Previous'}
    </button>
    <span id="page-indicator" class="text-sm font-semibold text-slate-600"></span>
    <button
      id="next-btn"
      type="button"
      class="rounded-full border border-slate-300 bg-white px-6 py-2 font-semibold text-slate-700 transition-all duration-300 hover:border-indigo-400 hover:text-indigo-700"
    >
      {locale === 'zh-TW' ? '下一頁' : 'Next'} →
    </button>
  </nav>
</section>

<script is:inline>
  const section = document.querySelector('section[data-base-path]');
  const perPage = Number(section?.getAttribute('data-per-page') ?? '20');
  const initialPage = Number(section?.getAttribute('data-initial-page') ?? '1');
  let selectedCategory = '';
  let currentPage = Number.isFinite(initialPage) && initialPage > 0 ? initialPage : 1;

  const getCategoryFromUrl = () => {
    const params = new URLSearchParams(window.location.search);
    return params.get('category') ?? '';
  };

  const getPageFromUrl = () => {
    const match = window.location.pathname.match(/\/page\/(\d+)\/?$/);
    if (!match) return currentPage;
    const n = Number.parseInt(match[1], 10);
    return Number.isFinite(n) && n > 0 ? n : 1;
  };

  const setActiveCategoryButton = (category) => {
    document.querySelectorAll('.category-btn').forEach((btn) => {
      const cat = btn.getAttribute('data-category') ?? '';
      const active = cat === category;
      btn.classList.toggle('border-indigo-600', active);
      btn.classList.toggle('bg-indigo-600', active);
      btn.classList.toggle('text-white', active);
      btn.classList.toggle('border-slate-300', !active);
      btn.classList.toggle('bg-white', !active);
      btn.classList.toggle('text-slate-700', !active);
    });
  };

  const render = () => {
    const stories = Array.from(document.querySelectorAll('[data-story]'));
    const filtered = selectedCategory
      ? stories.filter((node) => node.getAttribute('data-category') === selectedCategory)
      : stories;

    const totalPages = Math.max(1, Math.ceil(filtered.length / perPage));
    currentPage = Math.max(1, Math.min(currentPage, totalPages));
    const start = (currentPage - 1) * perPage;
    const visible = new Set(filtered.slice(start, start + perPage));

    stories.forEach((node) => {
      node.style.display = visible.has(node) ? '' : 'none';
    });

    const empty = document.getElementById('stories-empty');
    if (empty) {
      empty.style.display = filtered.length === 0 ? '' : 'none';
    }

    const nav = document.getElementById('pagination-nav');
    const indicator = document.getElementById('page-indicator');
    const prevBtn = document.getElementById('prev-btn');
    const nextBtn = document.getElementById('next-btn');

    if (indicator) {
      indicator.textContent = `${currentPage} / ${totalPages}`;
    }
    if (prevBtn) {
      prevBtn.style.visibility = currentPage <= 1 ? 'hidden' : 'visible';
    }
    if (nextBtn) {
      nextBtn.style.visibility = currentPage >= totalPages ? 'hidden' : 'visible';
    }
    if (nav) {
      nav.classList.toggle('hidden', totalPages <= 1);
      nav.classList.toggle('flex', totalPages > 1);
    }
  };

  const pushCategoryToUrl = () => {
    const basePath = section?.getAttribute('data-base-path') ?? '';
    const params = new URLSearchParams();
    if (selectedCategory) {
      params.set('category', selectedCategory);
    }
    const query = params.toString();
    const path = currentPage > 1 ? `${basePath}/page/${currentPage}` : basePath;
    history.pushState({}, '', `${path}${query ? `?${query}` : ''}`);
  };

  selectedCategory = getCategoryFromUrl();
  currentPage = getPageFromUrl();
  setActiveCategoryButton(selectedCategory);
  render();

  document.querySelectorAll('.category-btn').forEach((link) => {
    link.addEventListener('click', (event) => {
      event.preventDefault();
      selectedCategory = link.getAttribute('data-category') ?? '';
      currentPage = 1;
      setActiveCategoryButton(selectedCategory);
      pushCategoryToUrl();
      render();
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });
  });

  document.getElementById('prev-btn')?.addEventListener('click', () => {
    currentPage = Math.max(1, currentPage - 1);
    pushCategoryToUrl();
    render();
    window.scrollTo({ top: 0, behavior: 'smooth' });
  });

  document.getElementById('next-btn')?.addEventListener('click', () => {
    currentPage += 1;
    pushCategoryToUrl();
    render();
    window.scrollTo({ top: 0, behavior: 'smooth' });
  });

  window.addEventListener('popstate', () => {
    selectedCategory = getCategoryFromUrl();
    currentPage = getPageFromUrl();
    setActiveCategoryButton(selectedCategory);
    render();
  });
</script>
