---
import type { Locale } from '../../lib/i18n';
import type { NewsEntry } from '../../lib/news';
import { categoryLabels } from '../../lib/categories';
import { localeBasePath, siteCopy } from '../../lib/i18n';
import StoryCard from './StoryCard.astro';

interface Props {
  locale: Locale;
  entries: NewsEntry[];
  categoryCounts: Array<{ key: string; count: number }>;
  currentPage?: number;
  perPage?: number;
}

const { locale, entries, categoryCounts, currentPage = 1, perPage = 20 } = Astro.props;
const copy = siteCopy[locale];
const basePath = localeBasePath(locale);

const url = new URL(Astro.request.url);
const selectedCategory = url.searchParams.get('category') ?? null;
const filteredEntries = selectedCategory
  ? entries.filter((entry) => entry.data.category === selectedCategory)
  : entries;

const total = filteredEntries.length;
const pages = Math.ceil(total / perPage);
const urlPageParam = parseInt(url.searchParams.get('page') ?? '', 10);
const resolvedPage = isNaN(urlPageParam) ? currentPage : urlPageParam;
const page = Math.max(1, Math.min(resolvedPage, pages));
const start = (page - 1) * perPage;
const end = start + perPage;
const paginatedEntries = filteredEntries.slice(start, end);

const buildCategoryUrl = (category: string | null) => {
  const params = new URLSearchParams();
  if (category) params.set('category', category);
  params.set('page', '1');
  return `${basePath}${params.toString() ? `?${params.toString()}` : ''}`;
};

const prevHref = page > 1 
  ? `${basePath}${selectedCategory ? `?category=${selectedCategory}&` : '?'}page=${page - 1}` 
  : null;
const nextHref = page < pages 
  ? `${basePath}${selectedCategory ? `?category=${selectedCategory}&` : '?'}page=${page + 1}` 
  : null;
---

<section class="space-y-8">
  {/* Category Filter */}
  <div class="flex flex-wrap gap-2">
    {selectedCategory ? (
      <a
        href={buildCategoryUrl(null)}
        class="rounded-full border-2 border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-700 transition-all duration-300 hover:border-indigo-400 hover:text-indigo-700"
      >
        {copy.allCategories}
      </a>
    ) : (
      <span class="rounded-full border-2 border-indigo-600 bg-indigo-600 px-4 py-2 text-sm font-semibold text-white">
        {copy.allCategories}
      </span>
    )}
    {categoryCounts.map((item) => {
      const isCurrent = selectedCategory === item.key;
      return isCurrent ? (
        <span
          class="rounded-full border-2 border-indigo-600 bg-indigo-600 px-4 py-2 text-sm font-semibold text-white"
        >
          {categoryLabels[item.key]?.[locale]} ({item.count})
        </span>
      ) : (
        <a
          href={buildCategoryUrl(item.key)}
          class="rounded-full border-2 border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-700 transition-all duration-300 hover:border-indigo-400 hover:text-indigo-700"
        >
          {categoryLabels[item.key]?.[locale]} ({item.count})
        </a>
      );
    })}
  </div>

  {/* Stories */}
  {paginatedEntries.map((entry) => (
    <StoryCard locale={locale} entry={entry} />
  ))}
  {paginatedEntries.length === 0 && (
    <article class="rounded-3xl border border-dashed border-slate-300 bg-white p-8 text-slate-600">
      {copy.empty}
    </article>
  )}

  {/* Pagination */}
  {pages > 1 && (
    <nav aria-label="Pagination" class="flex items-center justify-center gap-4 py-8">
      {prevHref && (
        <a
          href={prevHref}
          class="rounded-full border border-slate-300 bg-white px-6 py-2 font-semibold text-slate-700 transition-all duration-300 hover:border-indigo-400 hover:text-indigo-700"
        >
          ← {locale === 'zh-TW' ? '上一頁' : 'Previous'}
        </a>
      )}
      <span class="text-sm font-semibold text-slate-600">
        {page} / {pages}
      </span>
      {nextHref && (
        <a
          href={nextHref}
          class="rounded-full border border-slate-300 bg-white px-6 py-2 font-semibold text-slate-700 transition-all duration-300 hover:border-indigo-400 hover:text-indigo-700"
        >
          {locale === 'zh-TW' ? '下一頁' : 'Next'} →
        </a>
      )}
    </nav>
  )}
</section>
