---
import type { Locale } from '../../lib/i18n';
import type { NewsEntry } from '../../lib/news';
import { categoryKeys, categoryLabels } from '../../lib/categories';
import { localeBasePath, siteCopy } from '../../lib/i18n';
import StoryCard from './StoryCard.astro';

interface Props {
  locale: Locale;
  entries: NewsEntry[];
  categoryCounts: Array<{ key: string; count: number }>;
  currentPage?: number;
  totalPages?: number;
  perPage?: number;
  activeCategory?: string;
}

const { locale, entries, categoryCounts, currentPage = 1, totalPages = 1, perPage = 20, activeCategory = '' } = Astro.props;
const copy = siteCopy[locale];
const basePath = localeBasePath(locale);

const buttonBase = 'rounded-full border-2 px-4 py-2 text-sm font-semibold transition-all duration-300';
const buttonIdle = 'border-slate-300 bg-white text-slate-700 hover:border-indigo-400 hover:text-indigo-700';
const buttonActive = 'border-indigo-600 bg-indigo-600 text-white';
const navButtonBase = 'rounded-full border border-slate-300 bg-white px-6 py-2 font-semibold text-slate-700 transition-all duration-300 hover:border-indigo-400 hover:text-indigo-700';

const pageHref = (page: number) => {
  const base = activeCategory ? `${basePath}/category/${activeCategory}` : basePath;
  return page <= 1 ? base : `${base}/page/${page}`;
};

const visibleCategories = categoryCounts.filter((item) => categoryKeys.includes(item.key));
---

<section class="space-y-8">
  <div id="category-filter" class="flex flex-wrap gap-2">
    <a
      href={basePath}
      class={`${buttonBase} ${activeCategory === '' ? buttonActive : buttonIdle}`}
    >
      {copy.allCategories}
    </a>
    {visibleCategories.map((item) => (
      <a
        href={`${basePath}/category/${item.key}`}
        class={`${buttonBase} ${activeCategory === item.key ? buttonActive : buttonIdle}`}
      >
        {categoryLabels[item.key]?.[locale]} ({item.count})
      </a>
    ))}
  </div>

  <div id="stories-container" class="space-y-8">
    {entries.map((entry) => (
      <StoryCard locale={locale} entry={entry} />
    ))}
    {entries.length === 0 && (
      <p class="rounded-3xl border border-dashed border-slate-300 bg-white p-8 text-slate-600">{copy.empty}</p>
    )}
  </div>

  {totalPages > 1 && (
    <nav aria-label="Pagination" class="flex items-center justify-center gap-4 py-8">
      {currentPage > 1 ? (
        <a href={pageHref(currentPage - 1)} class={navButtonBase} rel="prev">
          ← {locale === 'zh-TW' ? '上一頁' : 'Previous'}
        </a>
      ) : (
        <span class={`${navButtonBase} invisible`}>← {locale === 'zh-TW' ? '上一頁' : 'Previous'}</span>
      )}
      <span class="text-sm font-semibold text-slate-600">{currentPage} / {totalPages}</span>
      {currentPage < totalPages ? (
        <a href={pageHref(currentPage + 1)} class={navButtonBase} rel="next">
          {locale === 'zh-TW' ? '下一頁' : 'Next'} →
        </a>
      ) : (
        <span class={`${navButtonBase} invisible`}>{locale === 'zh-TW' ? '下一頁' : 'Next'} →</span>
      )}
    </nav>
  )}
</section>
