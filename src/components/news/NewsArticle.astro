---
import Layout from '../../layouts/Layout.astro';
import type { Locale } from '../../lib/i18n';
import { localeBasePath } from '../../lib/i18n';
import type { NewsEntry } from '../../lib/news';

interface Props {
  locale: Locale;
  entry: NewsEntry;
  content: any;
}

const { locale, entry, content: Content } = Astro.props;
const backLabel = locale === 'en' ? 'Back to homepage' : '返回首頁';
const sourceLabel = locale === 'en' ? 'Original source' : '原始來源';
---

<Layout locale={locale} title={entry.data.title}>
  <main class="mx-auto flex w-full max-w-4xl flex-col space-y-12 px-5 py-10 sm:px-8 sm:py-14">
    <header class="rounded-3xl border border-slate-200 bg-gradient-to-br from-white via-slate-50 to-indigo-50 p-8">
      <a
        href={localeBasePath(locale)}
        class="inline-flex items-center rounded-full border border-slate-300 bg-white px-4 py-2 text-sm font-bold text-slate-700 transition-all duration-300 hover:border-indigo-400 hover:text-indigo-700"
      >
        {backLabel}
      </a>

      <h1 class="mt-6 font-['Merriweather'] text-4xl font-black tracking-tight text-slate-900 sm:text-5xl">{entry.data.title}</h1>
      <p class="mt-5 font-['Merriweather'] text-lg leading-relaxed text-slate-700">{entry.data.summary}</p>

      <div class="mt-6 flex flex-wrap items-center gap-3 text-sm text-slate-600">
        <time datetime={entry.data.publishedAt.toISOString()}>
          {entry.data.publishedAt.toLocaleDateString(locale === 'zh-TW' ? 'zh-Hant-TW' : 'en-US', {
            year: 'numeric',
            month: 'long',
            day: 'numeric',
          })}
        </time>
        <span class="h-1 w-1 rounded-full bg-slate-400"></span>
        <a
          href={entry.data.sourceUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="font-bold text-indigo-700 underline decoration-indigo-300 underline-offset-4 transition-all duration-300 hover:decoration-indigo-700"
        >
          {sourceLabel}: {entry.data.sourceName}
        </a>
      </div>
    </header>

    <article class="prose prose-slate max-w-none rounded-3xl border border-slate-200 bg-white p-8 prose-headings:font-['Merriweather'] prose-headings:font-bold prose-p:font-['Merriweather'] prose-p:leading-relaxed prose-a:text-indigo-700 hover:prose-a:text-indigo-900">
      <Content />
    </article>
  </main>
</Layout>
